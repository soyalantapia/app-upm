# PostgreSQL (Railway: usar la referencia ${{Postgres.DATABASE_URL}} en prod,
# o la DATABASE_PUBLIC_URL del dashboard para desarrollo local / migraciones)
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Orígenes permitidos para CORS (coma-separados, sin barra final)
ALLOWED_ORIGINS=https://soyalantapia.github.io,http://localhost:5188,http://127.0.0.1:5188

# Secreto para firmar JWT (generar con: openssl rand -hex 32)
JWT_SECRET=cambiame

# Opcional: habilita POST /assistant con Claude real. Sin ella → 503 + fallback al mock del front.
# ANTHROPIC_API_KEY=sk-ant-...

# Opcional: base para los JSON estáticos curados cuando no están en el filesystem
# STATIC_DATA_BASE=https://soyalantapia.github.io/app-upm/data

PORT=3000
